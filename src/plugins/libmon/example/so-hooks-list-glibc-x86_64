# libmon hook list for a glibc x86-64 guest, passed with --so-hooks-list.
#
# Format (same grammar as apimon's --dll-hooks-list):
#   <so name>,<function name|hex offset>[,no-retval],<log|log+stack>[,<arg>,...]
#
# The <so name> is matched against the basename of the mapped path, so
# "libc.so.6" matches /lib/x86_64-linux-gnu/libc.so.6. Matching is
# case-sensitive, unlike the Windows DLL equivalent.
#
# Each <arg> is [Name:]type. Only a few types change formatting (lpstr/lpcstr
# read a NUL-terminated string, pulong/pulonglong dereference a pointer); any
# other type name just documents the signature and prints the raw value.

# process and library loading
libc.so.6,execve,log,Path:lpcstr,argv:lpvoid,envp:lpvoid
libc.so.6,fork,log
libc.so.6,system,log,Command:lpcstr
libdl.so.2,dlopen,log,Path:lpcstr,Flags:int

# files
libc.so.6,open,log,Path:lpcstr,Flags:int
libc.so.6,openat,log,DirFd:int,Path:lpcstr,Flags:int
libc.so.6,unlink,log,Path:lpcstr
libc.so.6,rename,log,From:lpcstr,To:lpcstr

# network
libc.so.6,connect,log,Fd:int,SockAddr:lpvoid,AddrLen:int
libc.so.6,getaddrinfo,log,Node:lpcstr,Service:lpcstr,Hints:lpvoid,Result:lpvoid

# memory
libc.so.6,mprotect,log,Addr:lpvoid,Len:ulong,Prot:int
libc.so.6,memfd_create,log,Name:lpcstr,Flags:int

# TLS
libssl.so,SSL_write,log,Ssl:lpvoid,Buf:lpcstr,Num:int
libssl.so,SSL_read,log,Ssl:lpvoid,Buf:lpvoid,Num:int
